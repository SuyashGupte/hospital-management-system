<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 2.5//EN"
    "http://struts.apache.org/dtds/struts-2.5.dtd">

<struts>
    <constant name="struts.devMode" value="false" />
    <constant name="struts.enable.DynamicMethodInvocation" value="true" />
    <constant name="struts.action.extension" value="action,do,," />
    <constant name="struts.mapper.action.prefix.enabled" value="true" />
    <constant name="struts.multipart.maxSize" value="52428800" />
    <constant name="struts.action.excludePattern" value="/assets/.*,/reports/.*" />

    <package name="default" extends="struts-default" namespace="/">
        <global-allowed-methods>regex:.*</global-allowed-methods>

        <!-- Authentication -->
        <action name="LoginService" class="com.hospital.actions.LoginAction" method="login">
            <result name="success" type="redirect">home.jsp</result>
            <result name="error" type="redirect">index.jsp?error=true</result>
        </action>

        <action name="login" class="com.hospital.actions.LoginAction" method="login">
            <result name="success" type="redirect">home.jsp</result>
            <result name="error" type="redirect">index.jsp?error=true</result>
        </action>

        <action name="logout" class="com.hospital.actions.LoginAction" method="logout">
            <result name="success" type="redirect">index.jsp</result>
        </action>

        <!-- Dispatcher Process Action -->
        <action name="Process" class="com.hospital.actions.ProcessAction">
            <result name="success">home.jsp</result>
            <result name="error">index.jsp?error=true</result>
        </action>

        <!-- Admin Actions -->
        <action name="admin_*" class="com.hospital.actions.AdminAction" method="{1}">
            <result name="success" type="redirect">empmgmt.jsp?add=true</result>
            <result name="error" type="redirect">empmgmt.jsp?error=true</result>
        </action>

        <!-- Doctor Actions -->
        <action name="doctor_*" class="com.hospital.actions.DoctorAction" method="{1}">
            <result name="success" type="redirect">dieseasePatient.jsp</result>
            <result name="error" type="redirect">dieseasePatient.jsp?error=true</result>
        </action>

        <!-- Pharmacist Actions -->
        <action name="pharmacy_*" class="com.hospital.actions.PharmatiestAction" method="{1}">
            <result name="success" type="redirect">drugmgmt.jsp</result>
            <result name="error" type="redirect">drugmgmt.jsp?error=true</result>
        </action>

        <!-- Receptionist Actions -->
        <action name="reception_*" class="com.hospital.actions.ReceptioniestAction" method="{1}">
            <result name="success" type="redirect">patientmgmt.jsp</result>
            <result name="error" type="redirect">patientmgmt.jsp?error=true</result>
        </action>

        <!-- User Actions -->
        <action name="user_*" class="com.hospital.actions.UserAction" method="{1}">
            <result name="success" type="redirect">home.jsp</result>
            <result name="error" type="redirect">home.jsp?error=true</result>
        </action>

        <!-- Report Actions -->
        <action name="report_*" class="com.hospital.actions.ReportAction" method="{1}">
        </action>

        <!-- Accountant Actions -->
        <action name="accountant_*" class="com.hospital.actions.AccountancyAction" method="{1}">
            <result name="success" type="redirect">computefees.jsp</result>
            <result name="error" type="redirect">computefees.jsp?error=true</result>
        </action>
    </package>
</struts>
